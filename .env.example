# Environment Variables Configuration Example
# Copy this file to .env.local to customize for local development

# Website URL & Identity
NEXT_PUBLIC_SITE_URL=https://example-ecommerce.com
NEXT_PUBLIC_SITE_NAME="Aura Commerce"

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=inquiries@auracommerce.example
NEXT_PUBLIC_CONTACT_PHONE="+1 (555) 234-5678"
NEXT_PUBLIC_WHATSAPP_NUMBER="15552345678"
NEXT_PUBLIC_STORE_ADDRESS="100 Luxury Avenue, Suite 400, New York, NY 10001"
